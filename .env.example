# ---------------------------------------------------------------
# Public site URL — used for canonical URLs, sitemap, Open Graph.
# Set this in Vercel to your final domain, e.g. https://geraldbaldoza.com
# Falls back to the Vercel deployment URL, then http://localhost:3000.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------
# Contact form delivery (server-side only, never exposed to browser)
# Uses the Resend email API: https://resend.com
#  1. Create a Resend account and an API key.
#  2. Verify a sending domain (or use onboarding@resend.dev for testing,
#     which can only deliver to the email address of your Resend account).
# If these are empty, the form will NOT pretend to send — it shows the
# visitor an honest "not configured" message with a direct-email fallback.
# ---------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
